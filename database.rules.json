{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": false,
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['id', 'name', 'alive', 'disconnected']) && newData.child('id').val() === $uid"
          }
        }
      }
    },
    "privateRooms": {
      "$roomId": {
        "players": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        }
      }
    }
  }
}
